# GEMINI_API_KEY: Optional/Default AI API Key for Gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional OpenAI-compatible API key configured by administrator
OPENAI_API_KEY="your_api_key_here"

# OPENAI_MODEL: Model to use for OpenAI-compatible endpoint (e.g. gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# PORT: Server listening port (default 3000)
PORT=3000
